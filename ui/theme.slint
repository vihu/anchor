// Design tokens: itele's design system with a sea-blue accent
// (.ai-docs/mockups/style.css).

export global Theme {
    out property <color> bg: #0b0c10;
    out property <color> surface-1: #111319;
    out property <color> surface-2: #181b23;
    out property <color> surface-3: #22262f;
    out property <color> surface-4: #2c313c;
    out property <color> line: #242833;
    out property <color> text: #f2f1ee;
    out property <color> text-2: #b0b4be;
    out property <color> text-3: #858a97;
    out property <color> accent: #4da3ff;
    out property <color> accent-hover: #6cb4ff;
    out property <color> accent-ink: #04152b;
    out property <color> accent-soft: #4da3ff21;
    out property <color> accent-line: #4da3ff8c;
    out property <color> on-image: #08090cb8;
    out property <color> danger: #ff8a7a;
    out property <color> ok: #3fb978;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 16px;

    out property <length> fs-xs: 12px;
    out property <length> fs-sm: 13px;
    out property <length> fs-md: 15px;
    out property <length> fs-lg: 18px;
    out property <length> fs-xl: 22px;
    out property <length> fs-2xl: 28px;
    out property <length> fs-3xl: 36px;
    out property <length> fs-4xl: 48px;
    out property <length> fs-5xl: 60px;
}
