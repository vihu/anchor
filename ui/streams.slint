// The streams panel: every stream addon's answer for a video, in the
// account's order and as each addon wrote it. Enter plays the selected
// stream in mpv. Layout: .ai-docs/mockups/05-movie.html.

import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Hint } from "atoms.slint";
import { StreamItem } from "models.slint";

export { StreamItem }

component StreamRow inherits Rectangle {
    in property <StreamItem> item;
    in property <bool> selected;
    callback clicked();
    height: root.item.heading ? 34px : max(76px, details.preferred-height + 24px);
    border-radius: Theme.radius-md;
    background: root.item.heading ? transparent : root.selected ? Theme.surface-2 : touch.has-hover ? Theme.surface-2 : transparent;
    border-width: root.selected && !root.item.heading ? 1px : 0px;
    border-color: Theme.accent-line;
    opacity: root.item.failed ? 0.5 : 1;
    HorizontalLayout {
        visible: root.item.heading;
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.item.name;
            color: Theme.text-3;
            font-size: Theme.fs-xs;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.item.details;
            color: Theme.text-3;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        visible: !root.item.heading;
        padding: 12px;
        spacing: 14px;
        VerticalLayout {
            width: 92px;
            alignment: start;
            spacing: 8px;
            Text {
                text: root.item.name;
                color: root.selected ? Theme.accent : Theme.text;
                font-size: Theme.fs-sm;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.item.tag != "": HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 22px;
                    width: tag.preferred-width + 16px;
                    border-radius: 5px;
                    background: root.item.failed ? Theme.surface-3 : Theme.accent-soft;
                    tag := Text {
                        text: root.item.tag;
                        color: root.item.failed ? Theme.text-2 : Theme.accent;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
            }
        }
        details := Text {
            text: root.item.details;
            color: Theme.text-2;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        enabled: !root.item.heading;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component StreamsPanel inherits Rectangle {
    // What the streams are for, for example "S2 E4 · The Pantry Job".
    in property <string> subtitle;
    in property <[StreamItem]> items;
    in property <int> index;
    // Shown instead of the list, for example "Asking AIOStreams…".
    in property <string> note;
    // Something went wrong playing, said over the list.
    in property <string> banner;
    callback play(int);
    callback close();

    // Scrolls the list so row `row` is visible.
    public function reveal(row: int) {
        let top = row * 90px;
        if (row <= 1) {
            list.content-y = 0;
        } else if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + 90px > -list.content-y + list.visible-height) {
            list.content-y = -(top + 90px - list.visible-height);
        }
    }

    width: 540px;
    background: Theme.surface-1;
    drop-shadow-blur: 40px;
    drop-shadow-offset-x: -18px;
    drop-shadow-color: #00000073;
    // Swallows clicks, so they do not reach the page under it.
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 16px;
            padding-top: 22px;
            padding-bottom: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: "Streams";
                    color: Theme.text;
                    font-size: Theme.fs-xl;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: Theme.text-3;
                    font-size: Theme.fs-sm;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: Theme.radius-md;
                    background: close-touch.has-hover ? Theme.surface-2 : transparent;
                    Image {
                        source: @image-url("icons/close.svg");
                        width: 20px;
                        height: 20px;
                        colorize: close-touch.has-hover ? Theme.text : Theme.text-2;
                    }
                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }
        if root.banner != "": HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 12px;
            Rectangle {
                border-radius: Theme.radius-md;
                background: #ff8a7a1a;
                height: banner-text.preferred-height + 24px;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 1px;
                        Image {
                            source: @image-url("icons/alert.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Theme.danger;
                        }
                    }
                    banner-text := Text {
                        text: root.banner;
                        color: Theme.text;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        if root.note != "": HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            Text {
                text: root.note;
                color: Theme.text-3;
                font-size: Theme.fs-md;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 12px;
            padding-right: 12px;
            list := ListView {
                for item[i] in root.items: StreamRow {
                    item: item;
                    selected: i == root.index;
                    clicked => {
                        root.play(i);
                    }
                }
            }
        }
        Rectangle {
            height: 44px;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                padding-left: 24px;
                spacing: 22px;
                alignment: start;
                Hint {
                    keys: ["↑", "↓"];
                    label: "Stream";
                }
                Hint {
                    keys: ["Enter"];
                    label: "Play in mpv";
                }
                Hint {
                    keys: ["Esc"];
                    label: "Close";
                }
            }
        }
    }
}
